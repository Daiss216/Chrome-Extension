{
  "manifest_version": 3,
  "name": "Globle Entry",
  "version": "1.0",
  "description": "Find the global entry interviews that meet your selection criteria!",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage"]
}
